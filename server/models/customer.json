{
  "name": "Customer",
  "plural": "customers",
  "base": "PersistedModel",
  "idInjection": true,
  "options": {
    "validateUpsert": true
  },
  "properties": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "createdAt": {
      "type": "date",
      "defaultFn": "now"
    },
    "updatedAt": {
      "type": "date",
      "defaultFn": "now"
    }
  },
  "relations": {
    "orders": {
      "type": "hasMany",
      "model": "Order",
      "foreignKey": "customerId"
    }
  }
}