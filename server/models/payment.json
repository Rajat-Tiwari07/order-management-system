{
  "name": "Payment",
  "plural": "payments",
  "base": "PersistedModel",
  "idInjection": true,
  "options": {
    "validateUpsert": true
  },
  "properties": {
    "orderId": {
      "type": "number",
      "required": true
    },
    "amount": {
      "type": "number",
      "required": true
    },
    "status": {
      "type": "string",
      "required": true,
      "default": "pending"
    },
    "transactionId": {
      "type": "string"
    },
    "paymentMethod": {
      "type": "string"
    },
    "createdAt": {
      "type": "date",
      "defaultFn": "now"
    },
    "updatedAt": {
      "type": "date",
      "defaultFn": "now"
    }
  },
  "relations": {
    "order": {
      "type": "belongsTo",
      "model": "Order",
      "foreignKey": "orderId"
    }
  }
}