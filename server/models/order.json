{
  "name": "Order",
  "plural": "orders",
  "base": "PersistedModel",
  "idInjection": true,
  "options": {
    "validateUpsert": true
  },
  "properties": {
    "customerId": {
      "type": "number",
      "required": true
    },
    "totalAmount": {
      "type": "number",
      "required": true,
      "default": 0
    },
    "status": {
      "type": "string",
      "required": true,
      "default": "pending"
    },
    "createdAt": {
      "type": "date",
      "defaultFn": "now"
    },
    "updatedAt": {
      "type": "date",
      "defaultFn": "now"
    }
  },
  "relations": {
    "customer": {
      "type": "belongsTo",
      "model": "Customer",
      "foreignKey": "customerId"
    },
    "items": {
      "type": "hasMany",
      "model": "OrderItem",
      "foreignKey": "orderId"
    },
    "payment": {
      "type": "hasOne",
      "model": "Payment",
      "foreignKey": "orderId"
    }
  }
}