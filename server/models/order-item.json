{
  "name": "OrderItem",
  "plural": "orderItems",
  "base": "PersistedModel",
  "idInjection": true,
  "options": {
    "validateUpsert": true
  },
  "properties": {
    "orderId": {
      "type": "number",
      "required": true
    },
    "productId": {
      "type": "number",
      "required": true
    },
    "quantity": {
      "type": "number",
      "required": true
    },
    "price": {
      "type": "number",
      "required": true
    },
    "createdAt": {
      "type": "date",
      "defaultFn": "now"
    }
  },
  "relations": {
    "order": {
      "type": "belongsTo",
      "model": "Order",
      "foreignKey": "orderId"
    },
    "product": {
      "type": "belongsTo",
      "model": "Product",
      "foreignKey": "productId"
    }
  }
}